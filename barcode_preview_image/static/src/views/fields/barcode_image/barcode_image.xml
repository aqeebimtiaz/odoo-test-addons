<?xml version="1.0" encoding="UTF-8"?>
<templates xml:space="preserve">

    <t t-name="barcode_preview_image.BarcodeField">
        <div class="o_phone_content d-inline-flex w-100">
            <t t-if="props.readonly">
                <a t-if="props.record.data[props.name]" class="o_form_uri" t-att-href="phoneHref" t-esc="props.record.data[props.name]"/>
            </t>
            <t t-else="">
                <input
                    class="o_input"
                    t-att-id="props.id"
                    type="text"
                    autocomplete="off"
                    t-att-placeholder="props.placeholder"
                    t-ref="input"
                />
            </t>
        </div>
    </t>

    <t t-name="barcode_preview_image.FormBarcodeField" t-inherit="barcode_preview_image.BarcodeField" t-inherit-mode="primary">
        <xpath expr="//input" position="after">
            <button
                t-if="props.record.data[props.name]"
                class="o_phone_form_link ms-3 d-inline-flex align-items-center btn btn-primary"
                t-on-click="onPreviewClick"
            >
                <!--data-bs-toggle="tooltip" data-bs-placement="top" data-bs-html="true" t-att-title="barcodeImgURL"-->
                <i class="fa fa-barcode"></i><small class="fw-bold ms-1">Preview</small>
            </button>
        </xpath>
    </t>

</templates>
